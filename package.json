{
  "name": "some-useful-links",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "aws-blocks"
  ],
  "scripts": {
    "predev": "npm run validate:links",
    "dev": "next dev --webpack",
    "dev:api": "tsx watch aws-blocks/scripts/server.ts",
    "validate:links": "node scripts/validate-links.mjs",
    "build": "npm run validate:links && next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "spec": "blocks-generate-spec",
    "sandbox": "tsx aws-blocks/scripts/sandbox.ts",
    "sandbox:destroy": "tsx -C cdk aws-blocks/scripts/sandbox-destroy.ts",
    "sandbox:console": "tsx aws-blocks/scripts/console.ts",
    "deploy": "tsx aws-blocks/scripts/deploy.ts",
    "destroy": "tsx aws-blocks/scripts/destroy.ts",
    "cleanup": "tsx aws-blocks/scripts/cleanup.ts"
  },
  "dependencies": {
    "@aws-blocks/blocks": "0.2.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1",
    "esbuild": "0.27.7",
    "impeccable": "3.6.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "^5.7.2"
  }
}
