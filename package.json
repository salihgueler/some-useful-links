{
  "name": "some-useful-links",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "cdk-blocks"
  ],
  "scripts": {
    "predev": "npm run validate:links",
    "dev": "next dev --webpack",
    "dev:api": "cdk-blocks dev",
    "validate:links": "node scripts/validate-links.mjs",
    "build": "npm run validate:links && next build --webpack",
    "start": "next start",
    "lint": "tsc --noEmit",
    "spec": "cdk-blocks spec",
    "sandbox": "cdk-blocks sandbox",
    "sandbox:destroy": "cdk-blocks sandbox:destroy",
    "sandbox:console": "cdk-blocks sandbox:console",
    "deploy": "cdk-blocks deploy",
    "destroy": "cdk-blocks destroy",
    "cleanup": "cdk-blocks cleanup",
    "docs": "cdk-blocks docs",
    "docs:search": "cdk-blocks docs --search",
    "docs:api": "cdk-blocks docs --api",
    "db": "cdk-blocks db",
    "whoami": "cdk-blocks whoami",
    "migrate": "cdk-blocks migrate",
    "help": "cdk-blocks --help",
    "generate-client": "cdk-blocks generate client"
  },
  "dependencies": {
    "aws-cdk-blocks": "1.0.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1",
    "esbuild": "0.27.7",
    "impeccable": "3.6.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.12",
    "typescript": "^5.7.2"
  },
  "blocks": {
    "dev": {
      "frontendPort": 3100
    }
  }
