{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://someusefullinks.com/schemas/links.schema.json",
  "title": "Some Useful Links - Multi-page Configuration",
  "description": "Schema for every public link page managed by the application.",
  "type": "object",
  "required": ["defaultSlug", "pages"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor and agent reference to this schema file."
    },
    "defaultSlug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Slug rendered at the root URL."
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["slug", "meta", "appearance", "links"],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "minLength": 2,
          "maxLength": 48,
          "description": "URL-safe page identifier."
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["title", "subtitle", "url"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 56
        },
        "subtitle": {
          "type": "string",
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "avatar": {
          "type": "string",
          "default": "/avatar.svg"
        },
        "badge": {
          "type": "string",
          "maxLength": 28,
          "description": "Small label under the header. Empty or absent hides it entirely."
        },
        "shareCaption": {
          "type": "string",
          "maxLength": 24,
          "description": "Small label beside the share-card QR code."
        },
        "shareNote": {
          "type": "string",
          "maxLength": 44,
          "description": "Line under the share-card caption. Defaults to the live link count."
        },
        "logo": {
          "type": "string",
          "maxLength": 262144,
          "description": "Optional conference logo as a raster data URL. Validated in links.validate.ts: image/png, image/jpeg, image/webp or image/gif only, never SVG."
        }
      },
      "additionalProperties": false
    },
    "appearance": {
      "type": "object",
      "required": [
        "primaryColor",
        "headerColor",
        "backgroundColor",
        "accentColor",
        "logoColor",
        "buttonStyle"
      ],
      "properties": {
        "primaryColor": { "$ref": "#/$defs/color" },
        "headerColor": { "$ref": "#/$defs/color" },
        "backgroundColor": { "$ref": "#/$defs/color" },
        "accentColor": { "$ref": "#/$defs/color" },
        "logoColor": { "$ref": "#/$defs/color" },
        "inkColor": { "$ref": "#/$defs/color" },
        "badgeColor": { "$ref": "#/$defs/color" },
        "buttonStyle": {
          "type": "string",
          "enum": ["raised", "flat", "outline"]
        }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "link": {
      "type": "object",
      "required": ["id", "label", "url", "icon"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "caption": {
          "type": "string",
          "maxLength": 60
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "icon": {
          "type": "object",
          "required": ["emoji"],
          "properties": {
            "emoji": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2
            },
            "backgroundColor": {
              "$ref": "#/$defs/color"
            }
          },
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
